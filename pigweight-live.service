[Unit]
Description=PigWeight live.py — waga swin (OAK-D + monitor 7")
# Czekaj na pulpit — OpenCV/DISPLAY i USB (OAK-D)
After=graphical.target network-online.target
Wants=network-online.target
# Bez limitu restartow — urzadzenie ma sie podnosic zawsze
StartLimitIntervalSec=0

[Service]
Type=simple
# User= / Group= / sciezki wstawia install_autostart.sh
WorkingDirectory=/REPLACE_ROOT
Environment=PIGWEIGHT_BOOT_DELAY=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/REPLACE_HOME/.Xauthority
Environment=HOME=/REPLACE_HOME
# OpenCV/Qt na Pi OS Bookworm (Wayland) — wymus X11/Xwayland
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/bin/bash /REPLACE_ROOT/start_live.sh
# always: takze gdy live.py zakonczy sie "normalnie" (np. zatrzymany pipeline)
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
